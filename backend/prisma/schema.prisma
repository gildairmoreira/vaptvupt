generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// No SQLite, enums não são suportados nativamente pelo Prisma, usamos String em vez disso.

model User {
  id               String         @id @default(uuid())
  role             String
  name             String
  email            String         @unique
  phone            String?
  status           String         @default("ACTIVE")
  blockExpiresAt   DateTime?
  createdAt        DateTime       @default(now())

  // Relationships
  clientTickets    Ticket[]       @relation("ClientTickets")
  providerTickets  Ticket[]       @relation("ProviderTickets")
  rejectionLogs    RejectionLog[]
}

model Ticket {
  id                 String       @id @default(uuid())
  clientId           String
  assignedProviderId String?
  status             String       @default("SEARCHING")
  type               String       @default("IMMEDIATE")
  isUrgent           Boolean      @default(false)
  
  // PostGIS doesn't have native Prisma support out of the box without unsupported extensions
  // For the sake of standard Prisma, we store lat/lng. For PostGIS we use raw queries.
  latitude           Float
  longitude          Float
  
  maxRadiusKm        Int          @default(5)
  scheduledFor       DateTime?
  createdAt          DateTime     @default(now())

  client             User         @relation("ClientTickets", fields: [clientId], references: [id])
  assignedProvider   User?        @relation("ProviderTickets", fields: [assignedProviderId], references: [id])
  rejectionLogs      RejectionLog[]
}

model RejectionLog {
  id           String          @id @default(uuid())
  providerId   String
  ticketId     String
  reason       String
  createdAt    DateTime        @default(now())

  provider     User            @relation(fields: [providerId], references: [id])
  ticket       Ticket          @relation(fields: [ticketId], references: [id])
}
